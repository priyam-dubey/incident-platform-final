# ---------------------------------------------------------------------------
# Copy to .env and fill in real values for local development.
# Never commit a populated .env file.
# ---------------------------------------------------------------------------

# --- Postgres (system of record: incidents, evidence, hypotheses, approvals) ---
POSTGRES_USER=incident_app
POSTGRES_PASSWORD=incident_app_dev_password
POSTGRES_DB=incident_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://incident_app:incident_app_dev_password@localhost:5432/incident_platform

# --- Redis (hot cache: dependency graphs, dedupe keys, rate limiting) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Kafka / Redpanda (telemetry event bus) ---
KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELEMETRY_EVENTS=telemetry.events
KAFKA_TOPIC_INCIDENT_CANDIDATES=incident.candidates
KAFKA_CONSUMER_GROUP_CORRELATION=correlation-engine

# --- ClickHouse (raw telemetry: logs/metrics/traces, high-cardinality queries) ---
CLICKHOUSE_USER=incident_app
CLICKHOUSE_PASSWORD=incident_app_dev_password
CLICKHOUSE_DB=incident_telemetry
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_URL=http://localhost:8123
# The api-gateway only READS telemetry. In production create a read-only ClickHouse user
# (GRANT SELECT ON incident_telemetry.* ... SETTINGS readonly=1) and use it for the gateway,
# separate from the ingestion service's write user. Leave CLICKHOUSE_URL empty to disable
# telemetry queries (the API then answers 503 telemetry_store_not_configured).
TELEMETRY_QUERY_TIMEOUT_SECONDS=10

# --- Ingestion service ---
INGESTION_SERVICE_PORT=8001
INGESTION_API_KEY_HEADER=X-Ingestion-Key
# Comma-separated list of valid ingestion API keys (rotate via this list, no downtime)
INGESTION_VALID_API_KEYS=dev-local-ingestion-key

# --- Correlation engine (Phase 3) ---
CORRELATION_SERVICE_PORT=8002
ANOMALY_ZSCORE_THRESHOLD=3.0
CORRELATION_WINDOW_SECONDS=60

# --- Reasoning service (Phase 4) ---
REASONING_SERVICE_PORT=8003
# --- LLM (shared by every AI feature; the ONLY two variables that pick model + credential) ---
# Format: <provider>/<model>. Supported providers: gemini
# Get a key at https://aistudio.google.com/apikey . Free-tier models/quotas change; check Google's docs.
LLM_MODEL=gemini/gemini-2.5-flash
LLM_API_KEY=
# Optional tuning
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# LLM_MAX_OUTPUT_TOKENS=4096
REASONING_MAX_ATTEMPTS=2

# --- Alert router (Phase 5) ---
ALERT_ROUTER_PORT=8004
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=

# --- Dashboard (Phase 6) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
DASHBOARD_PORT=3000

# --- Observability (Phase 7) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
ENVIRONMENT=development

# --- API gateway (auth, workspaces, applications, ingestion keys) ---
API_GATEWAY_PORT=8005
# REQUIRED outside development: long random string (e.g. `openssl rand -hex 32`). Signs access tokens.
AUTH_SECRET_KEY=dev-only-insecure-secret-change-me-32bytes!
COOKIE_SECURE=false            # true when served over HTTPS
CORS_ALLOWED_ORIGINS=http://localhost:3000
DASHBOARD_URL=http://localhost:3000
# Shared secret the ingestion service uses to verify per-application keys. Generate a random value.
INTERNAL_API_TOKEN=
PUBLIC_INGESTION_URL=http://localhost:8001
# Used only by tests: a real Postgres the integration tests may write to.
# TEST_DATABASE_URL=postgresql://incident_app:incident_app_dev_password@localhost:5432/incident_platform

# --- Ingestion service: per-application keys (SaaS mode) ---
# Set BOTH so each application's key decides the tenant (required outside development).
# GATEWAY_URL=http://api-gateway:8005
# INTERNAL_API_TOKEN=<same value as the gateway>
# REDACT_TELEMETRY=true
# MAX_EVENTS_PER_REQUEST=1000
